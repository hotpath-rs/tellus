+impl<S> Layer<S> for StaleTimers
+where
+    S: Subscriber,
+{
+    fn on_event(&self, event: &tracing::Event<'_>, _: Context<'_, S>) {
+        let mut stale_timer = StaleTimer(false);
+        event.record(&mut stale_timer);
+        if stale_timer.0 {
+            let _ = self.0.send(());
+        }
+    }
+}
+
+struct StaleTimer(bool);
