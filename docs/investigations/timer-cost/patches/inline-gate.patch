+/// The actor's sleep, pending while no timer is armed.
+pub(crate) struct TimerSleep<'a, M>(pub(crate) &'a mut ActorContext<M>);
+
+impl<M> Future for TimerSleep<'_, M> {
+    type Output = ();
+
+    // No waker without an armed sleep: timers change only in the actor's own callbacks on this
+    // task, and an armed sleep registers its own waker.
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        match self.0.timer_sleep() {
+            Some(sleep) => sleep.poll(cx),
+            None => Poll::Pending,
+        }
+    }
+}
